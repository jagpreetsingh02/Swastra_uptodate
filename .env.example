# ---------------------------------------------------------------- application
ENVIRONMENT=dev              # dev | test | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- persistence
# THERE IS NO SQLITE FALLBACK. The application refuses to start unless DATABASE_URL resolves
# to PostgreSQL; the only exemption is TESTING=1, which `tests/conftest.py` sets and nothing
# else does. A fallback is what once let a whole consultation be written to a local file
# while the Supabase tables everyone was watching stayed empty.
#
# TWO URLS, AND THEY ARE DIFFERENT ENDPOINTS ON PURPOSE.
#
# DATABASE_URL — the application runtime. Use the SESSION POOLER (Project Settings ->
# Database -> Connection string -> Session pooler), rewritten for the async driver:
#
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   Session mode, NOT the 6543 transaction pooler. Session mode gives one backend per client
#   for the life of the connection, so prepared statements work and application-side pooling
#   stays valid. Transaction mode does neither, and fails intermittently under load with
#   `prepared statement "__asyncpg_stmt_N__" does not exist`.
#
#   The pooler is also the only endpoint reachable on an IPv4-only network. The direct
#   endpoint `db.<ref>.supabase.co` is IPv6-ONLY: on a venue Wi-Fi, a hotspot, or most
#   conference NAT it does not resolve at all, and the backend simply never boots.
#
# MIGRATION_DATABASE_URL — Alembic only. Use the DIRECT connection:
#
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
#
#   Alembic wants one session for its DDL and version bookkeeping.
#   FALLBACK: if the direct endpoint is unreachable from where you are running migrations
#   (an IPv4-only network), point this at the SESSION pooler as well — port 5432, never
#   6543. Migrations through the transaction pooler can stop partway with some DDL already
#   committed, which is the worst place to fail.
#   If unset, migrations use DATABASE_URL.
#
# Set REQUIRE_SUPABASE=true alongside these.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_ECHO=false
REDIS_URL=redis://localhost:6379/0
SESSION_STORE_ALLOW_MEMORY_FALLBACK=true

# --- Supabase ------------------------------------------------------------------
# Backend only. SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely; it must never reach the
# browser, any VITE_* variable, or a commit. See docs/SUPABASE_SECURITY.md.
REQUIRE_SUPABASE=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=medical-documents

# ---------------------------------------------------------------- session lifecycle (Invariant 6)
GUEST_TTL_HOURS=24          # demo records older than this are swept on the next guest creation
SESSION_TTL_SECONDS=3600
PURGE_ON_SUBMIT=true

# ---------------------------------------------------------------- LLM
# `offline` is the safe default: the deterministic extractor. `auto` uses Groq when a key is
# present and silently stays offline when it is not — the demo never depends on a network.
LLM_BACKEND=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b   # llama-3.3-70b-versatile was decommissioned
GROQ_ASR_MODEL=whisper-large-v3-turbo
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------- speech
SPEECH_BACKEND=local        # local | whisper | bhashini | client
ASR_CONFIDENCE_THRESHOLD=0.62
VOSK_MODEL_DIR=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# ---------------------------------------------------------------- documents
OCR_BACKEND=textlayer        # textlayer | tesseract | handwriting
OCR_LOW_CONFIDENCE_THRESHOLD=0.72

# --- the handwriting lane (app/modules/documents/handwriting.py) ---
# khedim/Medical-Prescription-OCR is a GATED Hugging Face checkpoint. Verified end to end with
# real, authorised weights: it loads and runs, but answers fluently and confidently for ANY
# input — including a blank page, at 0.997 confidence — and never declines. Because
# HandwritingOCR is tried before Tesseract for every photograph, that combination meant every
# upload came back with nothing usable, regardless of what was on the page. See
# docs/adr/ADR-0017-khedim-verified-and-found-collapsed.md for the finding in full.
#
# DEFAULTS OFF as a result — real uploads go through Tesseract, which actually reads the page.
# Set true (or pass backend=handwriting per request) once this has been re-verified against a
# checkpoint that does not exhibit this. Leave HF_TOKEN blank to always use the fallback.
HF_TOKEN=
HANDWRITING_OCR_ENABLED=false
HANDWRITING_MODEL_ID=khedim/Medical-Prescription-OCR
HANDWRITING_DEVICE=auto      # auto | cpu | cuda | mps
HANDWRITING_BATCH_SIZE=8
HANDWRITING_MAX_NEW_TOKENS=128
# Beam width for generation. Blank defers to the checkpoint's OWN generation_config.json
# (khedim ships num_beams=4) rather than overriding its trained decoding strategy. Set to 1
# for a faster, deterministic greedy pass while iterating.
HANDWRITING_NUM_BEAMS=

# ---------------------------------------------------------------- terminology
NAMASTE_VERSION=1.0
ICD_RELEASE_ID=2026-01
DASHAVIDHA_VERSION=0.1.0

# ---------------------------------------------------------------- auth & policy
AUTH_REQUIRED=false          # true in any deployed environment
JWT_SECRET=dev-only-not-a-real-secret-change-me-in-any-deployment
JWT_ISSUER=mock-abdm-idp     # a MOCK issuer. Never presented as real ABDM.
JWT_AUDIENCE=medikiosk
POLICY_FILE=config/policy.yaml

# ---------------------------------------------------------------- HIS push
HIS_FHIR_ENDPOINT=http://localhost:8000/api/v1/stub-his/Bundle

# ---------------------------------------------------------------- AYUSH
AYUSH_MODE_DEFAULT=false
